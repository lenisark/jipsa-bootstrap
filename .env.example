# jipsa-bootstrap — 환경변수 템플릿 (토큰류)
# 실제 파일은 ~/.claude/secrets/slack-jipsa.env (chmod 600 / Windows ACL)
# 이 .env.example 은 GitHub에 올라가도 안전. 실제 토큰은 절대 커밋 금지.
#
# 참고: 채널별 모델·권한·샌드박스 설정은 .env 가 아니라
#       ~/.claude/scripts/slack-jipsa/channels.json 이 담당한다 (모듈 5 참고).

# ─────────────────────────────────────────────────────
# 슬랙 (필수)
# ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# 기본/개인 채널 ID. channels.json 없을 때 legacy 단일채널 fallback 대상.
SLACK_CHANNEL=C0XXXXXXXXX

# 본인 슬랙 user ID — access:owner 채널에서 봇이 응답할 대상
USER_SLACK_ID=U0XXXXXXXXX

# 봇 user ID — 자기 자신 메시지 무한루프 방지 (auth.test로 얻음)
BOT_USER_ID=U0XXXXXXXXX

# (선택) 두 봇 토론 모드용 채널. 안 쓰면 공란
SLACK_CHANNEL_DIALOG=

# 봇 표시 이름 (시스템 프롬프트·로그·노션에 사용)
SLACK_BOT_NAME=집사

# 사용자 호칭 (시스템 프롬프트에 사용. 예: 철수, 영희, John)
USER_NAME=사용자

# Stop hook → 슬랙 요약 webhook URL (선택, Incoming Webhook)
SLACK_SESSION_WEBHOOK=

# ─────────────────────────────────────────────────────
# 노션 적재 (모듈 4, 선택)
# ─────────────────────────────────────────────────────
# notion.so/my-integrations 에서 만든 Internal Integration Secret
NOTION_API_TOKEN=

# Claude Code 턴 로그 DB ID (32자 hex)
NOTION_SESSION_DB=

# (옵션) 일일 통합 DB ID
NOTION_DAILY_DB=
